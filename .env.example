# QuantaEdge corporate website local deployment.
# The container binds to loopback only; Cloudflare Tunnel should be the public ingress.
SITE_IMAGE=ghcr.io/manav326/quantaedge-site
IMAGE_TAG=latest
HOST_BIND_ADDRESS=127.0.0.1
SITE_PORT=13003

# Canonical public website origin (also passed at image build time).
NEXT_PUBLIC_SITE_URL=https://quantaedge.in

# Optional public email link; leave blank until the address is confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend enquiry delivery credentials (server-side only).
# RESEND_FROM_EMAIL must be a sender/domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
